<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shared container so the Quick Note widget can read the current target's
       name written by the app (QuickNoteShare). -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.mdcmd.ios</string>
  </array>
</dict>
</plist>
