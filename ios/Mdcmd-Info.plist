<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keys here are merged onto xtool's generated Info.plist (via the
       `infoPath` key in xtool.yml). Cross-platform: xtool just reads this
       file, so it works on the Linux CI path too. -->
  <key>CFBundleDisplayName</key>
  <string>MarkDown Commander</string>

  <!-- The app uses only standard HTTPS/TLS (GitHub API, image loads), which is
       exempt from US export encryption rules. Declaring this here skips the
       "Missing Compliance" prompt that otherwise blocks every TestFlight build
       from releasing automatically. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- Edit Markdown/text files opened from Files / iCloud Drive / Dropbox /
       Google Drive in place (edits the original), mirroring the Tauri app. -->
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>

  <!-- Surface the app's Documents folder in the Files app under
       "On My iPhone › MarkDown Commander", so the built-in local location is a
       real, two-way workspace users can also drop files into from Files. -->
  <key>UIFileSharingEnabled</key>
  <true/>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
        <string>public.plain-text</string>
        <string>public.text</string>
      </array>
    </dict>
  </array>

  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key>
      <string>Markdown</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>md</string>
          <string>markdown</string>
          <string>mdown</string>
          <string>mkd</string>
          <string>qmd</string>
        </array>
      </dict>
    </dict>
  </array>

  <!-- GitHub connection (optional). Mirrors the web build's VITE_GITHUB_* env
       vars. These are public values (no secret — the client secret lives in the
       OAuth proxy Worker, server/github-oauth-worker/). Leave GitHubClientID or
       GitHubOAuthProxy blank to hide GitHub entirely.
         - Create an OAuth App at https://github.com/settings/developers and add
           mdcmd://oauth/github as a callback URL.
         - Set GitHubClientID to the OAuth App's client id and GitHubOAuthProxy
           to the deployed Worker's URL. -->
  <key>GitHubClientID</key>
  <string>Ov23litXLjNNx01eyu1V</string>
  <key>GitHubOAuthProxy</key>
  <string>https://mdcmd-github-oauth.2615.workers.dev</string>
  <key>GitHubRedirectURI</key>
  <string>mdcmd://oauth/github</string>

  <!-- Custom scheme for the Quick Note widget deep link (mdcmd://quicknote) and
       the GitHub OAuth callback (mdcmd://oauth/github). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.mdcmd.app.deeplink</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>mdcmd</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
